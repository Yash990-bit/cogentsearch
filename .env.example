# ==========================================
# CogentSearch Configuration
# ==========================================

# LLM & Vision Provider Settings (Optional - runs 100% offline without keys)
# Free ultra-fast LLM inference via Groq (https://console.groq.com/keys)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VISION_MODEL_PROVIDER=openai # openai | anthropic | mock
VISION_MODEL_NAME=gpt-4o-mini # or claude-3-5-sonnet-20241022

# Optional LlamaParse Integration
LLAMA_CLOUD_API_KEY=your_llamaparse_api_key_here

# Embedding Configuration
EMBEDDING_PROVIDER=openai # openai | bge-m3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (Qdrant / Chroma)
VECTOR_DB_TYPE=qdrant # qdrant | chromadb
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=cogent_search_documents
CHROMA_PERSIST_DIR=./data/chroma_db

# Storage & Cache Directories
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
EXTRACTED_IMAGES_DIR=./data/extracted_images
PROCESSED_DOCS_DIR=./data/processed

# Logging
LOG_LEVEL=INFO

